# Copy this file to .env and replace every CHANGE-ME value with a random secret.
# Keep .env mode 0600. Never commit the copied file.

# Internal-only engine addresses. Public clients use the Caddy gateway address.
MISAKA_BASE_URL=http://misaka:7768
MISAKA_CONTROL_KEY=CHANGE-ME-misaka-control-key
DANMU_API_BASE_URL=http://danmu-api:9321
DANMU_API_TOKEN=CHANGE-ME-danmu-api-token
PUBLIC_API_TOKEN=CHANGE-ME-long-private-player-token

# Persistent Autopilot state inside the application container.
STATE_DIR=/data
SCRATCH_MAX_BYTES=524288000
MAX_REQUEST_BYTES=16777216
MAX_RESPONSE_BYTES=67108864
MAX_COMMENTS=500000

# Host-side Compose/Caddy values (bootstrap fills CHANGE-ME secrets).
TZ=Asia/Shanghai
ACME_EMAIL=you@example.com
DANMU_API_HOST=danmu.example.com
DANMU_ADMIN_HOST=danmu-admin.example.com
MYSQL_DATABASE=misaka
MYSQL_USER=misaka
MYSQL_PASSWORD=CHANGE-ME-mysql-password
MYSQL_ROOT_PASSWORD=CHANGE-ME-mysql-root-password
MISAKA_IMAGE=l429609201/misaka_danmu_server:latest
DANMU_API_IMAGE=logvar/danmu-api:latest
MYSQL_IMAGE=mysql:8.1.0-oracle
MISAKA_BIND_PORT=7768
AUTOPILOT_BIND_PORT=7770

# Optional authorized source credentials. Leave blank until configured in the
# administration workflow; values belong in a mode-0600 secret file in deploy.
BILIBILI_COOKIE_FILE=/run/secrets/bilibili-cookie
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=
