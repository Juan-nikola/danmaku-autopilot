# Copy to .env and chmod 600. bootstrap.sh fills the required random values.
TZ=Asia/Shanghai
ACME_EMAIL=you@example.com
DANMU_API_HOST=danmu.example.com
DANMU_ADMIN_HOST=danmu-admin.example.com

MYSQL_DATABASE=misaka
MYSQL_USER=misaka
MYSQL_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
MISAKA_CONTROL_KEY=CHANGE_ME_LONG_RANDOM_VALUE
DANMU_API_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE
PUBLIC_API_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE
MISAKA_IMAGE=l429609201/misaka_danmu_server:latest
DANMU_API_IMAGE=logvar/danmu-api:latest
DEVICE_TOKEN_1=CHANGE_ME_LONG_RANDOM_VALUE
DEVICE_TOKEN_2=CHANGE_ME_LONG_RANDOM_VALUE
DEVICE_TOKEN_3=CHANGE_ME_LONG_RANDOM_VALUE
CADDY_ADMIN_USER=admin
# Generate with: caddy hash-password --plaintext 'your-password'; keep the
# resulting $2a$... value single-quoted because bootstrap sources this file.
CADDY_ADMIN_HASH='CHANGE_ME_CADDY_HASH'

MISAKA_BIND_PORT=7768
AUTOPILOT_BIND_PORT=7770
SCRATCH_MAX_BYTES=524288000
BACKUP_DIR=./state/backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
CF_API_TOKEN=
CF_ZONE_ID=
